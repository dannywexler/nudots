gui:
  expandFocusedSidePanel: true
  expandedSidePanelWeight: 4
  language: en
  mainPanelSplitMode: horizontal
  nerdFontsVersion: "3"
  scrollHeight: 2
  showCommandLog: false
  showNumstatInFilesView: true
  showRandomTip: false
  statusPanelView: allBranchesLog
  theme:
    selectedLineBgColor: ["{{colors.blueDark}}"]

keybinding:
  universal:
    cyclePagers: |
    pullFiles: u
    pushFiles: p
    scrollDownMain: J
    scrollUpMain: K

notARepository: quit

update:
  method: never
